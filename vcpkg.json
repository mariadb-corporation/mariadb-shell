{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "my-project",
  "version-string": "1.0.0",
  "builtin-baseline": "18919708ee85a93da45f7eaa50f7998d0d0b1b7b",
  "dependencies": [
    {
      "name": "openssl",
      "features": [
        "tools"
      ]
    },
    "zlib",
    "libssh",
    "antlr4",
    "rapidjson",
    "sqlite3",
    {
      "name": "libffi",
      "platform": "!windows"
    },
    {
      "name": "liblzma",
      "platform": "!windows"
    },
    {
      "name": "bzip2",
      "platform": "!windows"
    },
    {
      "name": "curl",
      "features": [
        "openssl"
      ]
    },
    "zstd"
  ],
  "features": {
    "tests": {
      "description": "Dependencies of the unit-test suite; selected by -DWITH_TESTS=1",
      "dependencies": [
        "gtest"
      ]
    }
  },
  "overrides": [
    {
      "name": "openssl",
      "version": "3.6.3"
    },
    {
      "name": "libssh",
      "version": "0.12.0"
    },
    {
      "name": "gtest",
      "version": "1.17.0"
    },
    {
      "name": "antlr4",
      "version": "4.13.2",
      "port-version": 1
    },
    {
      "name": "curl",
      "version": "8.21.0"
    },
    {
      "name": "zlib",
      "version": "1.3.2"
    },
    {
      "name": "sqlite3",
      "version": "3.53.3",
      "port-version": 1
    }
  ]
}