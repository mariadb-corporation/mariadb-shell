{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "my-project",
  "version-string": "1.0.0",
  "builtin-baseline": "98d7375b79be7551ac3db6fbe668a08da9b1cac5",
  "dependencies": [
    {
      "name": "openssl",
      "features": [
        "tools"
      ]
    },
    "zlib",
    "libssh",
    "antlr4",
    "rapidjson",
    {
      "name": "sqlite3",
      "features": [
        "fts3",
        "fts4",
        "fts5",
        "math",
        "rtree"
      ]
    },
    "libffi",
    "liblzma",
    "bzip2",
    {
      "name": "mpdecimal",
      "platform": "windows"
    },
    {
      "name": "curl",
      "features": [
        "openssl"
      ]
    },
    "zstd"
  ],
  "features": {
    "tests": {
      "description": "Dependencies of the unit-test suite; selected by -DWITH_TESTS=1",
      "dependencies": [
        "gtest"
      ]
    }
  },
  "overrides": [
    {
      "name": "openssl",
      "version": "3.6.5",
      "port-version": 2
    },
    {
      "name": "libssh",
      "version": "0.12.2"
    },
    {
      "name": "gtest",
      "version": "1.17.0"
    },
    {
      "name": "antlr4",
      "version": "4.13.2",
      "port-version": 1
    },
    {
      "name": "curl",
      "version": "8.23.0"
    },
    {
      "name": "zlib",
      "version": "1.4"
    },
    {
      "name": "sqlite3",
      "version": "3.54.1"
    },
    {
      "name": "mpdecimal",
      "version": "4.0.1"
    }
  ]
}
