{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"terminal.integrated.scrollback": 1000000
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug Shell Plugins",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "localhost",
					"port": 5678,
					"timeout": 2000
				},
				// The shell runs the plugin COPIES under build/lib, not the
				// sources under python/plugins. Map the two so breakpoints set
				// in the source tree bind to the running modules.
				"pathMappings": [
					{
						"localRoot": "${workspaceFolder}/python/plugins",
						"remoteRoot": "${workspaceFolder}/build/lib/mariadb-shell/plugins"
					}
				],
				"justMyCode": false,
				"preLaunchTask": "Execute Shell in Python Mode",
				"postDebugTask": "Disable python debugging",
			},
			{
				"name": "Debug Shell Plugins (win)",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "localhost",
					"port": 5678,
					"timeout": 2000
				},
				"pathMappings": [
					{
						"localRoot": "${workspaceFolder}/python/plugins",
						"remoteRoot": "${workspaceFolder}/build/lib/mariadb-shell/plugins"
					}
				],
				"justMyCode": false,
				"preLaunchTask": "Execute Shell in Python Mode (win)",
				"postDebugTask": "Disable python debugging (win)",
			},
			{
				"name": "Debug Shell Plugins Attach",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "localhost",
					"port": 5678,
					"timeout": 2000
				},
				"pathMappings": [
					{
						"localRoot": "${workspaceFolder}/python/plugins",
						"remoteRoot": "${workspaceFolder}/build/lib/mariadb-shell/plugins"
					}
				],
				"justMyCode": false,
			},
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Enable python debugging",
				"type": "shell",
				"command": "ln",
				"args": [
					"-s",
					"${workspaceFolder}/tools/enable_python_debugger",
					"~/.mariadb-shell/init.d"
				],
			},
			{
				"label": "Enable python debugging (win)",
				"type": "shell",
				"command": "wt.exe",
				"args": [
					"cmd",
					"/c",
					"mklink /j %appdata%\\MySQL\\mysqlsh\\init.d ${workspaceFolder}\\tools\\enable_python_debugger"
				],
				"presentation": {
					"echo": true,
					"reveal": "never",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				},
				"problemMatcher": []
			},
			{
				"label": "Execute Shell in Python Mode",
				"type": "shell",
				"command": "${workspaceFolder}/build/bin/mariadb-shell",
				"args": [
					"--log-file",
					"${workspaceFolder}/mariadb-shell.log",
					"--py"
				],
				"isBackground": true,
				"dependsOn": "Enable python debugging",
				"problemMatcher": {
					"owner": "shell",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": [
						{
							"regexp": "^.*\\[.*\\]:\\s(Error|Warning|Info):\\s(.*)",
							"location": 0,
							"file": 0,
							"severity": 1,
							"message": 2
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "Started Debug Server",
						"endsPattern": ".*"
					}
				}
			},
			{
				"label": "Execute Shell in Python Mode (win)",
				"type": "shell",
				"command": "${workspaceFolder}/build/bin/mariadb-shell",
				"args": [
					"--log-file",
					"${workspaceFolder}/mariadb-shell.log",
					"--py"
				],
				"isBackground": true,
				"dependsOn": "Enable python debugging (win)",
				"presentation": {
					"echo": true,
					"reveal": "never",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				},
				"problemMatcher": {
					"owner": "shell",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": [
						{
							"regexp": "^.*\\[.*\\]:\\s(Error|Warning|Info):\\s(.*)",
							"location": 0,
							"file": 0,
							"severity": 1,
							"message": 2
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "Started Debug Server",
						"endsPattern": ".*"
					}
				}
			},
			{
				"label": "Execute Shell in Python Mode (win)",
				"type": "shell",
				"command": "${workspaceFolder}/build/bin/mariadb-shell",
				"args": [
					"--log-file",
					"${workspaceFolder}/mariadb-shell.log",
					"--py",
				],
				"isBackground": true,
				"dependsOn": "Enable python debugging (win)",
				"presentation": {
					"echo": true,
					"reveal": "never",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				},
				"problemMatcher": {
					"owner": "shell",
					"fileLocation": [
						"relative",
						"${workspaceFolder}"
					],
					"pattern": [
						{
							"regexp": "^.*\\[.*\\]:\\s(Error|Warning|Info):\\s(.*)",
							"location": 0,
							"file": 0,
							"severity": 1,
							"message": 2,
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "Started Debug Server",
						"endsPattern": ".*"
					}
				}
			},
			{
				"label": "Disable python debugging",
				"type": "shell",
				"command": "rm",
				"args": [
					"~/.mariadb-shell/init.d"
				],
				"problemMatcher": []
			},
			{
				"label": "Disable python debugging (win)",
				"type": "shell",
				"command": "wt.exe",
				"args": [
					"cmd",
					"/c",
					"rmdir %appdata%\\MySQL\\mysqlsh\\init.d"
				],
				"presentation": {
					"echo": true,
					"reveal": "never",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				},
				"problemMatcher": []
			}
		]
	},
	"extensions": {
		"recommendations": [
			"streetsidesoftware.code-spell-checker",
			"dbaeumer.vscode-eslint",
			"ms-python.python",
			"ms-python.vscode-pylance"
		]
	}
}