Source: mariadb-shell@PRODUCT_SUFFIX@
Section: database
Priority: optional
Maintainer: MariaDB Corporation <info@mariadb.com>
Standards-Version: 3.9.2
Build-Depends: debhelper (>= 8.9.4), cmake (>= 2.8.5), @DEB_BUILD_DEPS@
Homepage: https://mariadb.com/
Vcs-Git: https://github.com/mariadb-corporation/mariadb-shell.git
Vcs-Browser: https://github.com/mariadb-corporation/mariadb-shell

Package: mariadb-shell@PRODUCT_SUFFIX@
Section: database
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}, @DEB_DEPS@
# No "Provides: mysql-shell": this is not a drop-in replacement (no AdminAPI,
# dump/load, X DevAPI or Upgrade Checker), so it must not satisfy dependencies
# on mysql-shell.
Conflicts: mariadb-shell@CONFLICTING_PRODUCT_SUFFIX@
Replaces: mariadb-shell@CONFLICTING_PRODUCT_SUFFIX@
Description: MariaDB Shell
 MariaDB query and administration shell client and framework, with SQL and
 Python scripting modes. Installs as mariadb-shell, with msh provided as a
 short alias.
